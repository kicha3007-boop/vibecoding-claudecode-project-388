# Скопируй в .env (он в .gitignore) и заполни. Значения не коммитить.

# Telegram: токен от @BotFather и твой chat id (@userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# GitHub: fine-grained токен только на репозиторий tracker-data
# (Contents: Read and write, Metadata: Read-only). .mcp.json читает его из окружения:
# перед запуском Claude Code выполни export GITHUB_MCP_PAT=... (из .env он сам не подхватывается).
GITHUB_MCP_PAT=
TRACKER_DATA_REPO=owner/tracker-data

# Необязательно: локальная папка вместо GitHub — для репетиции без сети
# TRACKER_DATA_DIR=tracker-data
